<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="0dp">

    <!-- ส่วนรูปภาพ และป้ายแท็กสีม่วง "ตามหา" ด้านบน -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp">

        <ImageView
            android:id="@+id/ivWantedImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery" />

    </FrameLayout>

    <!-- ส่วนเนื้อหาด้านใน -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvWantedCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="หนังสือเรียน · PSRU SWAP"
                android:textColor="#00794C"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWantedBudget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="งบไม่เกิน\n300 บาท"
                android:textAlignment="viewEnd"
                android:textColor="#00794C"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvWantedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="ตามหาหนังสือ Introduction to Algorithms"
            android:textColor="#222222"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- การ์ดข้อมูลผู้โพสต์ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F4FBF7"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/ivUserProfile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_foreground" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="กัญญาณี ศรีสุข"
                    android:textColor="#222222"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUserFaculty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="คณะวิทยาศาสตร์และเทคโนโลยี · PSRU"
                    android:textColor="#666666"
                    android:textSize="10sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnViewProfile"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:backgroundTint="#E1F5FE"
                android:text="ดูโปรไฟล์"
                android:textColor="#0288D1"
                android:textSize="11sp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="รายละเอียด"
            android:textColor="#666666"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvWantedDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="รายละเอียดเพิ่มเติม..."
            android:textColor="#333333"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <!-- จุดนัดรับ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E8F8F0"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:tint="#00794C" />

            <TextView
                android:id="@+id/tvWantedLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="จุดนัดรับแนะนำภายใน ม.พิบูลสงคราม..."
                android:textColor="#00794C"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ปุ่มกดด้านล่าง -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnLikeWanted"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/btn_star_big_off" />

            <Button
                android:id="@+id/btnContactWanted"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:backgroundTint="#00794C"
                android:text="💬 ติดต่อผู้โพสต์ / นัดรับ"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>