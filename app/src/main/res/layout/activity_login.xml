<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- ส่วนหัวโลโก้ / ชื่อแอป -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="8dp"
        android:text="PSRU Swap 🎓"
        android:textColor="#00794C"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="ตลาดนัดส่งต่อของ ม.ราชภัฏพิบูลสงคราม"
        android:textColor="#666666"
        android:textSize="12sp" />

    <!-- ฟอร์มกรอกข้อมูลเข้าสู่ระบบ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:padding="20dp"
        android:elevation="2dp">

        <!-- อีเมล -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="อีเมล"
            android:textColor="#333333"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etLoginEmail"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="14dp"
            android:background="#F8F9FA"
            android:hint="เช่น student@psru.ac.th"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="12dp"
            android:textSize="13sp" />

        <!-- รหัสผ่าน -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="รหัสผ่าน"
            android:textColor="#333333"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etLoginPassword"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="20dp"
            android:background="#F8F9FA"
            android:hint="กรอกรหัสผ่านของคุณ"
            android:inputType="textPassword"
            android:paddingHorizontal="12dp"
            android:textSize="13sp" />

        <!-- ปุ่มเข้าสู่ระบบ -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#00794C"
            android:text="เข้าสู่ระบบ"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ปุ่มไปหน้าสมัครสมาชิก -->
    <TextView
        android:id="@+id/tvGoToRegister"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:clickable="true"
        android:focusable="true"
        android:text="ยังไม่มีบัญชี? สมัครสมาชิกที่นี่"
        android:textColor="#00794C"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>