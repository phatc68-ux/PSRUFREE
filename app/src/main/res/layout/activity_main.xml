<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:orientation="vertical">

    <!-- ส่วนหัวแอป -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#00794C"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PSRU Swap"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ตลาดนัดส่งต่อของ ม.ราชภัฏพิบูลสงคราม"
                android:textColor="#E2F0EC"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ปุ่มลงประกาศ (ใส่ ID เรียบร้อยแล้ว) -->
        <TextView
            android:id="@+id/btnOpenPost"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginRight="8dp"
            android:background="#00A86B"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="+ ลงประกาศ"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="#E2F0EC" />
    </LinearLayout>

    <!-- เนื้อหาหลัก (เลื่อนได้) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- แท็บสลับหน้า -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="14dp"
                android:background="#FFFFFF"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/tabMarketplace"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#00794C"
                    android:gravity="center"
                    android:text="🛒 ตลาดสินค้า (มีของ)"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabWantedBoard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="📢 บอร์ดตามหาของ"
                    android:textColor="#666666"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ช่องค้นหา -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="12dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:text="🔍"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ค้นหา ชื่อสินค้า หรือสิ่งที่อยากได้..."
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- หมวดหมู่ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"
                    android:background="#00794C"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="ทั้งหมด"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"
                    android:background="#FFFFFF"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="📖 หนังสือเรียน"
                    android:textColor="#444444"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="✏️ อุปกรณ์เรียน"
                    android:textColor="#444444"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- แบนเนอร์ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="#00A86B"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#00794C"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="พื้นที่สาธารณะราชภัฏพิบูลสงคราม"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="ของไม่ได้ใช้ ส่งต่อให้เพื่อนในมอ 🎓"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="ประหยัดเงินในกระเป๋า ลดขยะ ร่วมใจชาว PSRU"
                    android:textColor="#E2F0EC"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- หัวข้อรายการสินค้า -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="รายการสินค้า (ขาย / แลก / ให้ฟรี)"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6 รายการ"
                    android:textColor="#888888"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- รายการสินค้า (จำลอง 2 การ์ด) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- สินค้าชิ้นที่ 1 -->
                <LinearLayout
                    android:id="@+id/cardProduct1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginRight="8dp"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#00794C"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="ขาย"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:layout_marginTop="8dp"
                        android:background="#E9ECEF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="หนังสือเรียน"
                        android:textColor="#00794C"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="หนังสือ Java Programming &amp; OOP ฉบับสมบูรณ์"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="฿150"
                        android:textColor="#00794C"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- สินค้าชิ้นที่ 2 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="8dp"
                    android:background="#FFFFFF"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#00794C"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="ขาย"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:layout_marginTop="8dp"
                        android:background="#E9ECEF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="อุปกรณ์การเรียน"
                        android:textColor="#00794C"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="เครื่องคิดเลขวิทยาศาสตร์ Casio FX-990ES Plus"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="฿320"
                        android:textColor="#00794C"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- เมนูด้านล่างสุด (มี id ครบถ้วน) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navMarket"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🏠\nตลาดนัด"
            android:textColor="#00794C"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/navChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="💬\nแชท"
            android:textColor="#666666"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/navFavorite"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="❤️\nรายการโปรด"
            android:textColor="#666666"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="👤\nโปรไฟล์"
            android:textColor="#666666"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>