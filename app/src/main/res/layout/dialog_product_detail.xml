<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:background="@drawable/bg_rounded_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- ปิด / ปุ่มกากบาท -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#00A86B"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="ขาย"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:background="#DDDDDD"
            android:gravity="center"
            android:text="✕"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- รูปภาพสินค้า -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginBottom="12dp"
        android:background="#E9ECEF"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_gallery" />

    <!-- หมวดหมู่ และ ราคา -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="หนังสือเรียน · PSRU SWAP"
            android:textColor="#00794C"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="150"
            android:textColor="#00794C"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ชื่อสินค้า -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="หนังสือ Java Programming &amp; OOP ฉบับสมบูรณ์"
        android:textColor="#222222"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- ข้อมูลผู้โพสต์ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="#F8F9FA"
        android:gravity="center_vertical"
        android:padding="10dp">

        <View
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginRight="10dp"
            android:background="#CCCCCC" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ธนวัฒน์ ศึกษาดี"
                android:textColor="#333333"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="คณะวิทยาศาสตร์ฯ • PSRU"
                android:textColor="#777777"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="#E2F0EC"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="ดูโปรไฟล์"
            android:textColor="#00794C"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- รายละเอียด -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="รายละเอียด"
        android:textColor="#333333"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="หนังสือเรียนวิชาเขียนโปรแกรมคอมพิวเตอร์ สภาพ 90% ไม่มีรอยขีดเขียนด้านใน เหมาะสำหรับน้องปี 1-2 สาขาวิทยาการคอมพิวเตอร์หรือ IT ม.พิบูลสงคราม"
        android:textColor="#555555"
        android:textSize="11sp" />

    <!-- จุดนัดรับ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="#E2F0EC"
        android:gravity="center_vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:text="📍"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="จุดนัดรับแนะนำภายใน ม.พิบูลสงคราม:\nอาคารเรียนรวมและหอประชุม (กป.)"
            android:textColor="#0F5132"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ปุ่มกดด้านล่าง (ถูกใจ + ติดต่อ) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- ปุ่มถูกใจ (Heart) -->
        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/bg_rounded_card"
            android:gravity="center"
            android:text="❤️"
            android:textSize="16sp" />

        <!-- ปุ่มติดต่อผู้โพสต์ -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="#00794C"
            android:gravity="center"
            android:text="💬 ติดต่อผู้โพสต์ / นัดรับ"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>