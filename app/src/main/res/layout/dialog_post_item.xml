<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ส่วนหัว Popup (Title & Close Button) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ลงประกาศสินค้า"
                    android:textColor="#1A1A1A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="PSRU Swap &amp; Share"
                    android:textColor="#6C757D"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="✕"
                android:textColor="#495057"
                android:textSize="16sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- ส่วนเลือกรูปภาพสินค้า -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="รูปภาพสินค้า"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/btnSelectImage"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginBottom="16dp"
            android:background="#F8F9FA"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:stateListAnimator="@null">

            <!-- ImageView สำหรับแสดงรูปพรีวิว -->
            <ImageView
                android:id="@+id/ivPreviewImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- ตัวหนังสือหรือไอคอนตอนยังไม่เลือกรูป -->
            <LinearLayout
                android:id="@+id/layoutPlaceholderImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📸"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="แตะเพื่ออัปโหลดรูปภาพ"
                    android:textColor="#00794C"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="PNG, JPG (แนะนำรูปแนวตั้งหรือจัตุรัส)"
                    android:textColor="#ADB5BD"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ชื่อสินค้า -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="ชื่อสินค้า"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProductName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="#F8F9FA"
            android:hint="เช่น หนังสือเรียน Java Programming สภาพดี"
            android:paddingHorizontal="12dp"
            android:textSize="13sp"
            android:textColor="#212529"
            android:inputType="text" />

        <!-- หมวดหมู่ และ ราคา (แบ่งเป็น 2 คอลัมน์) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="หมวดหมู่"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerCategory"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#F8F9FA"
                    android:paddingHorizontal="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="ราคา (บาท)"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etProductPrice"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#F8F9FA"
                    android:hint="เช่น 150"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textSize="13sp"
                    android:textColor="#212529" />
            </LinearLayout>
        </LinearLayout>

        <!-- รายละเอียดเพิ่มเติม -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="รายละเอียดเพิ่มเติม"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProductDetail"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="16dp"
            android:background="#F8F9FA"
            android:gravity="top"
            android:hint="อธิบายสภาพสินค้า ตำหนิ หรือข้อมูลเพิ่มเติม..."
            android:padding="12dp"
            android:textSize="13sp"
            android:textColor="#212529"
            android:inputType="textMultiLine" />

        <!-- สถานที่นัดรับ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="สถานที่นัดรับใน ม.พิบูลสงคราม"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="24dp"
            android:background="#F8F9FA"
            android:hint="เช่น อาคารเรียนรวมและหอประชุม (กป.)"
            android:paddingHorizontal="12dp"
            android:textSize="13sp"
            android:textColor="#212529"
            android:inputType="text" />

        <!-- ปุ่มโพสต์ประกาศ -->
        <Button
            android:id="@+id/btnSubmitPost"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#00794C"
            android:text="โพสต์ประกาศลง PSRU Swap"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:elevation="2dp" />

    </LinearLayout>
</ScrollView>